[TEMPLATE]
# Contact form email (Resend)
# 1. Sign up at https://resend.com (free tier: 3,000 emails/month)
# 2. Create an API key: https://resend.com/api-keys  (format: re_xxxxxxxx)
# 3. Copy the key here (no spaces)
RESEND_API_KEY=re_your-api-key-here

# Where contact-form messages are delivered (your email address)
CONTACT_EMAIL=pragatipatil1428@gmail.com

# Optional: "From" address. Leave unset to use Resend's shared sender
# (onboarding@resend.dev), which can only send to your own CONTACT_EMAIL.
# To send from your own domain, verify it in Resend first, then set e.g.
# CONTACT_FROM_EMAIL=hello@yourdomain.com
# CONTACT_FROM_EMAIL=onboarding@resend.dev
